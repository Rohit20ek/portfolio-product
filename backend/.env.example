# Backend environment variables
# Copy this file to .env and fill in your values

# DATABASE: Get your connection string from Supabase (Settings -> Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# AUTH: Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# FRONTEND: URL of your deployed frontend (e.g., https://your-username.github.io/portfolio-product)
FRONTEND_URL=http://localhost:5173

# SESSION: Change this to a long random string in production
SESSION_SECRET=rohit-portfolio-secret-change-me

# MISC
PORT=3001
NODE_ENV=development
